[Unit]
Description=Trip Manager Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tripmanager
Group=tripmanager
WorkingDirectory=/opt/trip-manager
EnvironmentFile=/opt/trip-manager/.env
Environment=INSTANCE_PATH=/var/lib/trip-manager
ExecStart=/opt/trip-manager/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 --timeout 120 app:app
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
